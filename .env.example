################################################################################
# Omni Monitor — environment variables
#
# Copy this file to .env.local for local dev or set each value in your hosting
# provider's environment settings (Vercel, etc.). Production deployments do
# NOT need every variable — see AI_PRODUCTION_READINESS.md for the matrix.
################################################################################

# ── Required ─────────────────────────────────────────────────────────────────
# Supabase project URL and anon key. Without these, the app cannot start.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# ── AI provider selection ────────────────────────────────────────────────────
# AI_PROVIDER is the explicit override. Allowed values: ollama | openai | mock.
# If unset, the app auto-picks:
#   • OpenAI-compatible if OPENAI_API_KEY is present
#   • Ollama            if ENABLE_AI_ANALYSIS=true (and OPENAI_API_KEY is empty)
#   • Mock              otherwise
AI_PROVIDER=

# ── Ollama (local LAN or hosted Ollama-compatible) ───────────────────────────
# Set ENABLE_AI_ANALYSIS=true to allow Ollama selection by the auto-picker.
# OLLAMA_BASE_URL accepts any URL that exposes Ollama's /api/generate contract:
#   local LAN:  http://192.168.x.x:11434
#   hosted:     https://your-ollama.example.com
# Vercel cannot reach LAN IPs — for production use a hosted endpoint or a
# secure tunnel.
ENABLE_AI_ANALYSIS=false
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# ── OpenAI-compatible (OpenAI, Anthropic via adapter, Groq, Together, etc.) ──
# Setting OPENAI_API_KEY is enough to auto-pick this provider.
# OPENAI_BASE_URL defaults to https://api.openai.com/v1. Override for any
# self-hosted gateway, Groq (https://api.groq.com/openai/v1), etc.
# OPENAI_MODEL is provider-dependent: gpt-4o-mini, llama-3.1-70b, etc.
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o-mini
