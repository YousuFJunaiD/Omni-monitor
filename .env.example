################################################################################
# Omni Monitor — environment variables
#
# Copy this file to .env.local for local dev or set each value in your hosting
# provider's environment settings (Vercel, etc.). Production deployments do
# NOT need every variable — see AI_PRODUCTION_READINESS.md for the AI matrix
# and CLIENT_DEPLOYMENT_TEMPLATE.md for the client-branding matrix.
################################################################################

# ── Required ─────────────────────────────────────────────────────────────────
# Supabase project URL and anon key. Without these, the app cannot start.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# ── AI provider selection ────────────────────────────────────────────────────
# AI_PROVIDER is the explicit override. Allowed values: ollama | openai | mock.
# If unset, the app auto-picks:
#   • OpenAI-compatible if OPENAI_API_KEY is present
#   • Ollama            if ENABLE_AI_ANALYSIS=true (and OPENAI_API_KEY is empty)
#   • Mock              otherwise
AI_PROVIDER=

# ── Ollama (local LAN or hosted Ollama-compatible) ───────────────────────────
ENABLE_AI_ANALYSIS=false
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# ── OpenAI-compatible (OpenAI, Anthropic via adapter, Groq, Together, etc.) ──
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o-mini

################################################################################
# CLIENT BRANDING / CONFIG — VITE_CLIENT_* overrides
#
# These are read by src/config/clientConfig.js at build time. Every value below
# has an Omnimate default — leave a variable empty/unset to use the Omnimate
# value. Set a non-empty value to deploy this product for a different client.
#
# The CLIENT_DEPLOYMENT_TEMPLATE.md walks through the full client-onboarding
# workflow (intake form → fill these vars → deploy).
################################################################################

# Deployment mode marker. 'single_client' is the only mode shipped today.
# Multi-tenant ('multi_tenant') is planned but not implemented.
VITE_CLIENT_MODE=single_client

# ── Brand identity (visible everywhere in the UI) ────────────────────────────
# Omnimate defaults:
#   VITE_CLIENT_COMPANY_NAME   = 'Omnimate'
#   VITE_CLIENT_PRODUCT_NAME   = 'Omnimate Monitor'
#   VITE_CLIENT_LOGO_MARK      = 'OM'
#   VITE_CLIENT_TAGLINE        = 'Execution control'
#   VITE_CLIENT_APP_HEADING    = 'Execution OS'
VITE_CLIENT_COMPANY_NAME=
VITE_CLIENT_PRODUCT_NAME=
VITE_CLIENT_LOGO_MARK=
VITE_CLIENT_TAGLINE=
VITE_CLIENT_APP_HEADING=

# Industry/workspace context label (shown in NavBar workspace pill).
# Omnimate default: 'Operations'.
VITE_CLIENT_INDUSTRY_LABEL=
VITE_CLIENT_WORKSPACE_LABEL=

# ── AI assistant naming ──────────────────────────────────────────────────────
# Omnimate default: 'AI Executive'.
VITE_CLIENT_AI_ASSISTANT_NAME=

# ── Login + onboarding wording ───────────────────────────────────────────────
# Omnimate defaults:
#   VITE_CLIENT_LOGIN_DESCRIPTION    = 'Private workspace for the team.'
#   VITE_CLIENT_ONBOARDING_MESSAGE   = '' (no banner)
#   VITE_CLIENT_EMPTY_DASHBOARD_HINT = 'Create a task to give the team a clear owner, outcome, and next step.'
VITE_CLIENT_LOGIN_DESCRIPTION=
VITE_CLIENT_ONBOARDING_MESSAGE=
VITE_CLIENT_EMPTY_DASHBOARD_HINT=

# ── Placeholder text for the CEO finance/project card ────────────────────────
# (The card itself stays — the text is configurable. Omnimate default explains
# the placeholder is reserved for a future phase.)
VITE_CLIENT_FINANCE_PLACEHOLDER=

# ── Support contact (shown in docs and footers) ──────────────────────────────
# Omnimate defaults:
#   VITE_CLIENT_SUPPORT_EMAIL = 'support@omnimate.example'
#   VITE_CLIENT_SUPPORT_URL   = '' (no URL)
VITE_CLIENT_SUPPORT_EMAIL=
VITE_CLIENT_SUPPORT_URL=

# ── Demo mode ────────────────────────────────────────────────────────────────
# Set VITE_CLIENT_DEMO_BANNER_TEXT to a non-empty string to render a small
# top-of-app banner labelling the deployment as a demo. Leave blank for prod.
VITE_CLIENT_DEMO_LABEL=
VITE_CLIENT_DEMO_BANNER_TEXT=

# ── Department display labels ────────────────────────────────────────────────
# Keys ('frontend', 'backend') match user_department() in supabase/round4.
# Override these to relabel what users SEE without changing the DB function.
# Omnimate defaults:
#   VITE_CLIENT_DEPT_FRONTEND_LABEL = 'Frontend'
#   VITE_CLIENT_DEPT_BACKEND_LABEL  = 'Backend'
VITE_CLIENT_DEPT_FRONTEND_LABEL=
VITE_CLIENT_DEPT_BACKEND_LABEL=

# ── Role display labels (DB enum is unchanged: CEO/FOUNDER/BOARD/INTERN) ─────
# Omnimate defaults: 'CEO', 'Founder', 'Board / Dept Head', 'Intern'.
VITE_CLIENT_ROLE_CEO_LABEL=
VITE_CLIENT_ROLE_FOUNDER_LABEL=
VITE_CLIENT_ROLE_BOARD_LABEL=
VITE_CLIENT_ROLE_INTERN_LABEL=

# ── Footer / copyright owner ─────────────────────────────────────────────────
# Omnimate default: 'Omnimate'.
VITE_CLIENT_COPYRIGHT_OWNER=

# ── Feature flags (small UX toggles per client) ──────────────────────────────
# Omnimate defaults: VITE_CLIENT_FEATURE_DEMO_BANNER=false,
#                    VITE_CLIENT_FEATURE_REQUIRE_PROOF=true.
VITE_CLIENT_FEATURE_DEMO_BANNER=
VITE_CLIENT_FEATURE_REQUIRE_PROOF=
